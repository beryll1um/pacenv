if declare -F deactivate_%%NAME%% >/dev/null; then
	echo "The '%%NAME%%' is already sourced, or it may be name conflict."
	return
fi

deactivate_%%NAME%%() {
	PATH=${PATH//"%%ROOT%%usr/bin:"/}
	PS1=${PS1//"(%%NAME%%) "/}
	unset -f ${FUNCNAME[0]}
}

PATH="%%ROOT%%usr/bin:$PATH"
PS1="(%%NAME%%) $PS1"

